# Private server-side variables — configure in Vercel Project Settings > Environment Variables.
# Get this connection string from Neon. Never prefix it with VITE_.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require

# Generate a unique random value of at least 32 characters; keep it private.
AUTH_SECRET=GENERATE_UNE_VALEUR_ALEATOIRE_LONGUE_ET_UNIQUE

# Public canonical URL of the deployed site (used for SasPay return URLs).
NEXT_PUBLIC_SITE_URL=https://VOTRE-DOMAINE-VERCEL

# SasPay merchant credentials (server-side only).
SASPAY_API_KEY=REMPLACER_DANS_VERCEL
SASPAY_WEBHOOK_SECRET=REMPLACER_DANS_VERCEL
# Legacy alias supported if the provider account uses this name:
# SASPAY_CALLBACK_SECRET=

# Exact email address allowed to access the global ELS platform admin panel.
# Set the real value privately in Vercel; never use a public/shared address.
ELS_PLATFORM_ADMIN_EMAIL=admin@example.com
