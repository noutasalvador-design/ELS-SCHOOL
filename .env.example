# DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Migration en cours : l'interface actuelle utilise encore ces variables Supabase.
# Elles seront retirées après migration complète de src/App.tsx vers /api.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_PUBLISHABLE_OU_ANON
# Ne jamais mettre une clé service_role ou DATABASE_URL dans une variable VITE_.
